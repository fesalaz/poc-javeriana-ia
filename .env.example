# Copia este archivo a .env y completa tus credenciales (los 3 proveedores son
# de tier gratuito; ver GUIA_DESPLIEGUE_Y_PRUEBAS.md sección 0.1 y 2).

# --- Feature flag ---
USE_REAL_LLM_PROVIDERS=false   # true para usar los 3 proveedores reales en vez de mocks

# --- Tope por-llamada a cada proveedor LLM (segundos) ---
# Con 3 proveedores en fallback, sin este tope un solo proveedor "colgado"
# puede agotar todo el presupuesto de tiempo antes de que el circuit breaker
# conmute al siguiente (causa real de ReadTimeout/Status:timeout observados
# al probar la API desplegada — CloudWatch confirmó que el timeout propio de
# ChatGoogleGenerativeAI NO se respetó). Por eso el corte real lo aplica
# ProviderRegistry con un timeout de pared por hilo, no solo el parámetro
# `timeout=` de cada adaptador. Ver src/registry/provider_registry.py y
# GUIA_DESPLIEGUE_Y_PRUEBAS.md sección 0.2.
LLM_REQUEST_TIMEOUT_SECONDS=6

# --- 1) Google AI Studio (Gemini) — primario, también resuelve embeddings ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001   # text-embedding-004 se apagó el 14/01/2026

# --- 2) OpenAI gpt-oss-20b servido por Groq (tier gratuito) — respaldo 1 ---
OPENAI_OSS_BASE_URL=https://api.groq.com/openai/v1
OPENAI_OSS_API_KEY=
OPENAI_OSS_MODEL=openai/gpt-oss-20b

# --- 3) Meta Llama 3.3 servido por OpenRouter — respaldo 2 ---
# NOTA: el slug ":free" de este modelo dejó de estar disponible en la
# práctica en OpenRouter (responde 404 "This model is unavailable for free",
# aunque el catálogo web lo siga mostrando como "Free" — el tier gratuito de
# OpenRouter cambia de disponibilidad con frecuencia). Por eso el default es
# la variante de PAGO (barata: ~$0.10/$0.32 por 1M tokens) — requiere
# créditos cargados en la cuenta (Settings -> Credits). Si en el futuro
# OpenRouter vuelve a ofrecer ":free" para este modelo, solo cambia esta
# variable. Ver GUIA_DESPLIEGUE_Y_PRUEBAS.md, sección 0.1.
LLAMA_BASE_URL=https://openrouter.ai/api/v1
LLAMA_API_KEY=
LLAMA_MODEL=meta-llama/llama-3.3-70b-instruct

# --- 4) AWS Bedrock, Titan Text Embeddings V2 — respaldo 1 de embed() ---
# (agregado septiembre 2026, hallazgo R-7 de EVALUACION_ATAM_LITE.md: solo
# Gemini implementaba embed(); bajo carga real su circuit breaker se abrió
# sin ningún proveedor alterno al que conmutar). NO requiere API key: usa las
# credenciales del rol de ejecución de Lambda (IAM) vía boto3. AWS_REGION ya
# lo define Lambda automáticamente; en ejecución local, exporta AWS_REGION o
# configura tus credenciales de AWS CLI normalmente.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# --- 5) Voyage AI, voyage-4-lite — respaldo 2 de embed() ---
# Proveedor independiente de AWS (diversidad real frente a Bedrock). 200
# millones de tokens gratis por cuenta: https://dash.voyageai.com/
VOYAGE_BASE_URL=https://api.voyageai.com/v1
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite

# --- PostgreSQL + pgvector (local via docker-compose, o RDS en AWS) ---
# connect_timeout evita que una conexión colgada (BD inalcanzable) bloquee la
# construcción del Orquestador — causa real de un hang detectado en el PoC
# desplegado, que ocurría antes de llegar a los proveedores LLM. Ver
# GUIA_DESPLIEGUE_Y_PRUEBAS.md sección 0.2. En AWS, lambda_handler.py arma
# esta URL solo con host/puerto/db/usuario + POSTGRES_CONNECT_TIMEOUT_SECONDS
# (default 5); esta variable completa solo aplica a ejecución local.
POSTGRES_URL=postgresql+psycopg://postgres:postgres@localhost:5432/javeriana_ia?connect_timeout=5
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
